# Local development uses an embedded Postgres (PGlite) stored in ./data/pglite — nothing to install.
# For a real Postgres server (or Neon in production) use: postgresql://user:password@host:5432/db
DATABASE_URL=pglite://./data/pglite

# --- Accounts (Auth.js) ---
# Signs the session cookies. Required in production; generate one with: npx auth secret
# (or: openssl rand -base64 33). Local development works without it.
AUTH_SECRET=

# Google sign-in: an OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local testing).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev login (sign in with any email, no check) for a local production build such as the
# end-to-end tests. It is on by default under `npm run dev` and never on Vercel.
# AUTH_DEV_LOGIN=1
# Needed only when running `next start` yourself outside Vercel:
# AUTH_TRUST_HOST=true
